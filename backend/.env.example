# Server
PORT=4000

# Frontend URL (CORS allowed origins, comma-separated or *)
FRONTEND_ORIGIN=http://localhost:5173

# Google service account credentials (keep real private key in local .env only!)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Projects Google Sheet
GSHEET_PROJECTS_ID=your_projects_spreadsheet_id
GSHEET_PROJECTS_RANGE='Form Responses 1'!A1:Z1000

# Team Google Sheet
GSHEET_TEAM_ID=your_team_spreadsheet_id
GSHEET_TEAM_RANGE='Form Responses 1'!A1:I1000

