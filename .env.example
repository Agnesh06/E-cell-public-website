# Target Flask backend REST API base URL (Default local development: http://127.0.0.1:5000/api)
VITE_API_URL=http://127.0.0.1:5000/api
VITE_API_BASE_URL=http://127.0.0.1:5000/api

# Set to true only for offline frontend mock development (skips backend API)
VITE_USE_MOCK_API=false

# For testing mock failure states when VITE_USE_MOCK_API=true
VITE_MOCK_SUBMIT_FAILURE=false
